@model Reservation
@using BitByByte.Data;

@{
   ApplicationUser user = ViewBag.UserDetails;
}

<h1>Create a Reservation</h1>
<hr />

<h4>Search Sittings</h4>
<div class="searchBar">
    <input class="form-control me-sm-2" type="search" placeholder="Search" id="searchValue">
    <button class="btn btn-secondary my-2 my-sm-0" onclick="searchSittings()">Search</button>
</div>

<form asp-action="Create" enctype="multipart/form-data" class="form  text-light">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="SittingId" class="control-label">Select a Sitting</label>
        <select asp-for="SittingId" class="form-control" asp-items="ViewBag.SittingId"></select>
    </div>
    <div class="form-group">
        <label asp-for="FirstName" class="control-label"></label>
        <input asp-for="FirstName" class="form-control" value="@(user != null ? user.FirstName : "")" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="LastName" class="control-label"></label>
        <input asp-for="LastName" class="form-control" value="@(user != null ? user.LastName : "")" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="StartTime" class="control-label"></label>
        <input asp-for="StartTime" class="form-control" value=@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss") />
        <span asp-validation-for="StartTime" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Duration" class="control-label"></label>
        <input asp-for="Duration" class="form-control" />
        <span asp-validation-for="Duration" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Email" class="control-label"></label>
        <input asp-for="Email" class="form-control" value="@(user != null ? user.Email : "")" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="PhoneNumber" class="control-label"></label>
        <input asp-for="PhoneNumber" class="form-control" value="@(user != null ? user.PhoneNumber : "")" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Notes" class="control-label"></label>
        <input asp-for="Notes" class="form-control" />
        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="GuestCount" class="control-label"></label>
        <input asp-for="GuestCount" class="form-control" max="40" />
        <span asp-validation-for="GuestCount" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ReservationSource" class="control-label"></label>
        <select asp-for="ReservationSource" class="form-control" asp-items="ViewBag.ReservationSourceList"></select>
        <span asp-validation-for="ReservationSource" class="text-danger"></span>
    </div>

    <div class="form-group">
        <input type="submit" value="Create" class="btn btn-primary" />
    </div>
</form>


<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<script defer>

    function searchSittings() {
        let searchValue = document.getElementById("searchValue");
        console.log(searchValue.value);
        getAvailableSittings(searchValue.value);
    }

    function populateOptions(data) {
        const element = document.getElementById("SittingId");
        element.innerHTML = ""; // Clear existing options

        // Loop through the data and create option elements
        data.forEach((item) => {
            const option = document.createElement("option");
            option.value = item.value;
            option.text = item.text;
            element.appendChild(option);
        });
    }

    // GET endpoint search database Sittings for type containing query
    async function getAvailableSittings(query) {
        try {
            const data = await fetch(`https://localhost:7149/Sittings/GetAvailableSittings/?query=${query}`, {
                method: "get",
            })
                .then(res => res.json())
                .then(data => {
                    console.log(data)
                    populateOptions(data);
                })
        }
        catch (err) {
            console.log(err)
        }
    }

</script>