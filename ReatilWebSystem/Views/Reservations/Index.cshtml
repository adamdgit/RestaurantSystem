@model IEnumerable<Reservation>

@{
    var userName = User.Identity.Name;
}

<div class="d-flex gap-4 align-items-center mb-4">
    <h1>Reservations</h1>
    <a asp-action="Create" class="btn btn-primary">Create Reservation</a>
</div>

@if (string.IsNullOrEmpty(userName))
{
    <p class="text-light">
        Please register and log in to view your reservations.
    </p>
} else
{
    <table class="table">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.FirstName)</th>
                <th>@Html.DisplayNameFor(model => model.LastName)</th>
                <th>@Html.DisplayNameFor(model => model.StartTime)</th>
                <th>@Html.DisplayNameFor(model => model.Duration)</th>
                <th>@Html.DisplayNameFor(model => model.Email)</th>
                <th>@Html.DisplayNameFor(model => model.PhoneNumber)</th>
                <th>@Html.DisplayNameFor(model => model.Notes)</th>
                <th>@Html.DisplayNameFor(model => model.Status)</th>
                <th>@Html.DisplayNameFor(model => model.GuestCount)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.FirstName)</td>
                    <td>@Html.DisplayFor(modelItem => item.LastName)</td>
                    <td>@Html.DisplayFor(modelItem => item.StartTime)</td>
                    <td>@Html.DisplayFor(modelItem => item.Duration)</td>
                    <td>@Html.DisplayFor(modelItem => item.Email)</td>
                    <td>@Html.DisplayFor(modelItem => item.PhoneNumber)</td>
                    <td>@Html.DisplayFor(modelItem => item.Notes)</td>
                    <td>@Html.DisplayFor(modelItem => item.Status)</td>
                    <td>@Html.DisplayFor(modelItem => item.GuestCount)</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.ReservationId">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.ReservationId">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.ReservationId">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}


