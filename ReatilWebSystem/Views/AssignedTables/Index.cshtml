@model IEnumerable<BitByByte.Models.AssignedTable>

@{
    ViewData["Title"] = "Index";
    var assignedTables = ViewData["assignedTables"] as List<BitByByte.Models.AssignedTable>;
}

<div class="d-flex gap-4 align-items-center mb-4">
    <h1>Assigned Tables</h1>
    <a asp-action="Create" class="btn btn-primary">Assign a table</a>
</div>

<div>
    <h3>Sort by:</h3>
    <div class="d-flex gap-4 pt-2 pb-4">
        <button class="btn btn-primary" onclick="sortEmail()">Email</button>
        <button class="btn btn-primary" onclick="sortTime()">Start Time</button>
    </div>
</div>

<table class="table">
    <thead>
        <tr>
            <th>
                Table Name
            </th>
            <th>
                ID
            </th>
            <th>
                Name
            </th>
            <th>
                Email
            </th>
            <th>
                Sitting Details
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody id="tableBody">
        @foreach (var item in ViewBag.assignedTables)
        {
        <tr>
            <td>
                @($"{item.TableInfo.Name}")
            </td>
            <td>
                @($"{item.Reservation.ReservationId}")
            </td>
            <td>
                @($"{item.Reservation.FirstName} {item.Reservation.LastName}")
            </td>
            <td>
                @($"{item.Reservation.Email}")
            </td>
            <td>
                @($"{item.Sitting.Type} - {item.Reservation.StartTime}")
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.AssignedTableId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.AssignedTableId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.AssignedTableId">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>

<script defer>

    const tableEl = document.getElementById('tableBody');

    // switch between asc and desc
    let sort1 = false;
    let sort2 = false;

    // convert C# list to javascript array of objects
    let data = @Html.Raw(Json.Serialize(assignedTables));

    console.log(data);

    function rebuildTableData() {
        // rebuild table with sorted data
        data.forEach((item, i) => {
            console.log(item)
            const tr = tableEl.children[i]

            const tdname = tr.children[0];
            tdname.innerText = item.tableInfo.name;

            const tdID = tr.children[1];
            tdID.innerText = item.reservationId;

            const tdfullname = tr.children[2];
            tdfullname.innerText = item.reservation.firstName + " " + item.reservation.lastName;

            const tdemail = tr.children[3];
            tdemail.innerText = item.reservation.email;

            const tdsitting = tr.children[4];
            tdsitting.innerText = item.sitting.type + " - " +
                new Date(item.reservation.startTime).toLocaleString("en-au")
        });
    }

    function sortEmail() {
        // switch between asc and desc
        sort1 = !sort1;
        // asc
        if (sort1) {
            data.sort((a, b) => {
                return a.reservation.email.toLowerCase() > b.reservation.email.toLowerCase() ? 1 : -1
            });
        }
        // desc
        else {
            data.sort((a, b) => {
                return a.reservation.email.toLowerCase() < b.reservation.email.toLowerCase() ? 1 : -1
            });
        }

        rebuildTableData()
    };

    function sortTime() {
        // switch between asc and desc
        sort2 = !sort2;
        // asc
        if (sort2) {
            data.sort((a, b) => {
                let dateA = new Date(a.reservation.startTime).getTime();
                let dateB = new Date(b.reservation.startTime).getTime();

                return dateA > dateB ? 1 : -1
            });
        }
        // desc
        else {
            data.sort((a, b) => {
                let dateA = new Date(a.reservation.startTime).getTime();
                let dateB = new Date(b.reservation.startTime).getTime();

                return dateA < dateB ? 1 : -1
            });
        }

        rebuildTableData()
    };

</script>