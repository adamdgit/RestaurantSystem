@model EditUser
@{
    var message = TempData["msg"];
}

<h1>Your Account</h1>

@if(ViewBag.UserDetails.ProfileUrl != "none")
{
    <img src="@ViewBag.UserDetails.ProfileUrl" alt="profile picture" width="250" />
} else
{
    <p>No profile picture set.</p>
}

<div class="row">
    <div class="col-md-4">
        <h2>@message</h2>
        <form asp-controller="User" asp-action="Edit" method="post" enctype="multipart/form-data">
            <h2>Update your details</h2>
            <hr />
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <input asp-for="Id" class="form-control" hidden="true" readonly value="@ViewBag.UserDetails.Id" />
            <div class="form-floating mb-3">
                <input asp-for="FirstName" class="form-control" autocomplete="FirstName" aria-required="true" placeholder="FirstName" value="@ViewBag.UserDetails.FirstName" />
                <label asp-for="FirstName">FirstName</label>
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="LastName" class="form-control" autocomplete="LastName" aria-required="true" placeholder="LastName" value="@ViewBag.UserDetails.LastName" />
                <label asp-for="LastName">Last Name</label>
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Email" class="form-control" autocomplete="UserName" aria-required="true" placeholder="name@example.com" value="@ViewBag.UserDetails.Email" />
                <label asp-for="Email">Email</label>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="PhoneNumber" class="form-control" aria-required="true" value="@ViewBag.UserDetails.PhoneNumber" />
                <label asp-for="PhoneNumber">Phone Number</label>
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            @if(User.IsInRole("admin"))
            {
                <div class="form-floating mb-3">
                    <input asp-for="Role" class="form-control" aria-required="true" value="@ViewBag.UserDetails.Role" />
                    <label asp-for="Role">Role</label>
                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>
            }

            <label for="file" style="color: white;">Upload profile picture</label>
            <div class="form-floating mb-3">
                <input class="form-control" style="padding: 1.1rem 1.5rem;" name="file" type="file" />
                <span asp-validation-for="ProfileUrl" class="text-danger"></span>
            </div>

            <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Update Details</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
