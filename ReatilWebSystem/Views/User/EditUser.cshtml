@model EditUser
@{

}

<h1>Edit User Info</h1>

<div class="row">
    <div class="col-md-4">
        <form asp-controller="User" asp-action="EditUser" method="post">
            <h2>Update users details</h2>
            <hr />
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <input asp-for="Id" class="form-control" hidden="true" readonly value=@Model.Id />
            <div class="form-floating mb-3">
                <input asp-for="FirstName" class="form-control" autocomplete="FirstName" aria-required="true" placeholder="FirstName" value=@Model.FirstName />
                <label asp-for="FirstName">FirstName</label>
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="LastName" class="form-control" autocomplete="LastName" aria-required="true" placeholder="LastName" value=@Model.LastName />
                <label asp-for="LastName">Last Name</label>
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Email" class="form-control" autocomplete="UserName" aria-required="true" placeholder="name@example.com" value=@Model.Email />
                <label asp-for="Email">Email</label>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="PhoneNumber" class="form-control" aria-required="true" value=@Model.PhoneNumber />
                <label asp-for="PhoneNumber">Phone Number</label>
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
                <div class="form-floating mb-3">
                <input asp-for="Role" class="form-control" aria-required="true" value=@Model.Role />
                    <label asp-for="Role">Role</label>
                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>
            <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Update Details</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
